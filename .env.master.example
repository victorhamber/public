# MASTER unificado — copie para .env.master

# Typebot
ENCRYPTION_SECRET=replace-with-32-plus-random-chars!!
DATABASE_URL=postgresql://postgres:typebot@typebot-db:5432/typebot
NEXTAUTH_URL=http://localhost:8080
NEXT_PUBLIC_VIEWER_URL=http://localhost:8081
ADMIN_EMAIL=admin@example.com
WEBHOOK_RELAY_SECRET=replace-with-another-32-plus-secret

# Publishing UI (iframe / nav) + Forge
NEXT_PUBLIC_POSTIZ_URL=http://localhost:4007
NEXT_PUBLIC_PUBLISHING_EMBED_URL=http://localhost:4007/launches
# Server-side Forge (viewer/builder) — hostname do compose
# SSRF_ALLOWED_HOSTS já inclui publishing no compose

# Publishing (Postiz)
PUBLISHING_PUBLIC_URL=http://localhost:4007
PUBLISHING_JWT_SECRET=replace-publishing-jwt-secret
PUBLISHING_DB_USER=postiz-user
PUBLISHING_DB_PASSWORD=postiz-password
PUBLISHING_DB_NAME=postiz-db
PUBLISHING_IMAGE=ghcr.io/gitroomhq/postiz-app:v2.25.3
# Após vendor + build local: PUBLISHING_IMAGE=master-publishing:local

# WAHA (texto plano no Postiz; sha512 no container WAHA)
WAHA_API_KEY=
WAHA_API_KEY_SHA512=

# Imagens Typebot com bloco Forge (build deste repo)
# TYPEBOT_BUILDER_IMAGE=master-typebot-builder:local
# TYPEBOT_VIEWER_IMAGE=master-typebot-viewer:local
